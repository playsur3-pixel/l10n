msgid "HLAE"
msgstr "HLAE"

msgid "Translations"
msgstr "Traductions"

msgid "advancedfx.org"
msgstr "advancedfx.org"

msgid "A newer version of [ProductName] is already installed."
msgstr "Une version plus récente de [ProductName] est déjà installée."

msgid "FFMPEG"
msgstr "FFMPEG"

msgid "FFMPEG can be used for encoding mirv_streams to videos."
msgstr "FFMPEG peut être utilisé pour encoder mirv_streams en vidéos."

msgid "{\\\\WixUI_Font_Title}FFMPEG"
msgstr "{\\\\WixUI_Font_Title}FFMPEG"

msgid "Install FFMPEG or use exsiting one."
msgstr "Installez FFMPEG ou utilisez une version existante."

msgid "Reinstall FFMPEG"
msgstr "Réinstaller FFMPEG"

msgid "FFMPEG will be downloaded from GitHub.com and installed using your current internet connection and proxy settings."
msgstr "FFMPEG sera téléchargé depuis GitHub.com et installé en utilisant votre connexion Internet actuelle et vos paramètres de proxy."

msgid "Select version:"
msgstr "Sélectionner la version :"

msgid "latest (recommended)"
msgstr "dernière (recommandée)"

msgid "Select existing on disk"
msgstr "Sélectionner une version existante sur le disque"

msgid "Select linking:"
msgstr "Sélectionner le type de liaison :"

msgid "static (faster, 100 MB download, recommended)"
msgstr "statique (plus rapide, téléchargement de 100 Mo, recommandée)"

msgid "shared (smaller, 50 MB download)"
msgstr "partagée (plus petite, téléchargement de 50 Mo)"

msgid "Select license:"
msgstr "Sélectionner la licence :"

msgid "GPL3 (complete, recommended)"
msgstr "GPL3 (complète, recommandée)"

msgid "LGPL3 (less features, more permissive)"
msgstr "LGPL3 (moins de fonctionnalités, plus permissive)"

msgid "Please enter the full path to your custom ffmpeg.exe here:"
msgstr "Veuillez saisir ici le chemin complet vers votre ffmpeg.exe personnalisé :"

msgid "Browse"
msgstr "Parcourir"

msgid "{\\\\WixUI_Font_Bold}File does not exist or is not accessible. Please fix and click Next button to try again."
msgstr "{\\\\WixUI_Font_Bold}Le fichier n’existe pas ou n’est pas accessible. Corrigez puis cliquez sur le bouton Suivant pour réessayer."

msgid "Installing FFMPEG ..."
msgstr "Installation de FFMPEG…"

msgid "Connecting to [AFX_FFMPEGURL]"
msgstr "Connexion à [AFX_FFMPEGURL]"

msgid "..."
msgstr "..."

msgid "Downloading [AFX_FFMPEGURL]"
msgstr "Téléchargement de [AFX_FFMPEGURL]"

msgid "[1] of [2] Bytes"
msgstr "[1] sur [2] octets"

msgid "Verifying checksum"
msgstr "Vérification de la somme de contrôle"

msgid "[1] of [2] Bytes"
msgstr "[1] sur [2] octets"

msgid "Extracting FFMPEG"
msgstr "Extraction de FFMPEG"

msgid "Item [1] of [2] ..."
msgstr "Élément [1] sur [2]…"

msgid "The HLAE application folder path contains invalid characters: Only basic latin character set is allowed (7bit ASCII)."
msgstr "Le chemin du dossier de l’application HLAE contient des caractères invalides : seuls les caractères latins de base sont autorisés (ASCII 7 bits)."

msgid "Remove HLAE application data folder (not recommended)."
msgstr "Supprimer le dossier de données d’application HLAE (non recommandé)."
